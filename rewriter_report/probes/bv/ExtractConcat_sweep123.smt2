; ExtractConcat: every (j,i) over concat of widths 1,2,3 vs independently computed slices.
; EXPECT: unsat
(set-logic QF_BV)
(declare-const a (_ BitVec 1))
(declare-const b (_ BitVec 2))
(declare-const c (_ BitVec 3))
(assert (not (and
  (= ((_ extract 0 0) (concat a b c)) ((_ extract 0 0) c))
  (= ((_ extract 1 0) (concat a b c)) ((_ extract 1 0) c))
  (= ((_ extract 2 0) (concat a b c)) c)
  (= ((_ extract 3 0) (concat a b c)) (concat ((_ extract 0 0) b) c))
  (= ((_ extract 4 0) (concat a b c)) (concat b c))
  (= ((_ extract 5 0) (concat a b c)) (concat a b c))
  (= ((_ extract 1 1) (concat a b c)) ((_ extract 1 1) c))
  (= ((_ extract 2 1) (concat a b c)) ((_ extract 2 1) c))
  (= ((_ extract 3 1) (concat a b c)) (concat ((_ extract 0 0) b) ((_ extract 2 1) c)))
  (= ((_ extract 4 1) (concat a b c)) (concat b ((_ extract 2 1) c)))
  (= ((_ extract 5 1) (concat a b c)) (concat a b ((_ extract 2 1) c)))
  (= ((_ extract 2 2) (concat a b c)) ((_ extract 2 2) c))
  (= ((_ extract 3 2) (concat a b c)) (concat ((_ extract 0 0) b) ((_ extract 2 2) c)))
  (= ((_ extract 4 2) (concat a b c)) (concat b ((_ extract 2 2) c)))
  (= ((_ extract 5 2) (concat a b c)) (concat a b ((_ extract 2 2) c)))
  (= ((_ extract 3 3) (concat a b c)) ((_ extract 0 0) b))
  (= ((_ extract 4 3) (concat a b c)) b)
  (= ((_ extract 5 3) (concat a b c)) (concat a b))
  (= ((_ extract 4 4) (concat a b c)) ((_ extract 1 1) b))
  (= ((_ extract 5 4) (concat a b c)) (concat a ((_ extract 1 1) b)))
  (= ((_ extract 5 5) (concat a b c)) a))))
(check-sat)
