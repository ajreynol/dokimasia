; ExtractConcat: every (j,i) over 4-ary concat of widths 2,1,1,2 (width-1 middle children).
; EXPECT: unsat
(set-logic QF_BV)
(declare-const a (_ BitVec 2))
(declare-const b (_ BitVec 1))
(declare-const c (_ BitVec 1))
(declare-const d (_ BitVec 2))
(assert (not (and
  (= ((_ extract 0 0) (concat a b c d)) ((_ extract 0 0) d))
  (= ((_ extract 1 0) (concat a b c d)) d)
  (= ((_ extract 2 0) (concat a b c d)) (concat c d))
  (= ((_ extract 3 0) (concat a b c d)) (concat b c d))
  (= ((_ extract 4 0) (concat a b c d)) (concat ((_ extract 0 0) a) b c d))
  (= ((_ extract 5 0) (concat a b c d)) (concat a b c d))
  (= ((_ extract 1 1) (concat a b c d)) ((_ extract 1 1) d))
  (= ((_ extract 2 1) (concat a b c d)) (concat c ((_ extract 1 1) d)))
  (= ((_ extract 3 1) (concat a b c d)) (concat b c ((_ extract 1 1) d)))
  (= ((_ extract 4 1) (concat a b c d)) (concat ((_ extract 0 0) a) b c ((_ extract 1 1) d)))
  (= ((_ extract 5 1) (concat a b c d)) (concat a b c ((_ extract 1 1) d)))
  (= ((_ extract 2 2) (concat a b c d)) c)
  (= ((_ extract 3 2) (concat a b c d)) (concat b c))
  (= ((_ extract 4 2) (concat a b c d)) (concat ((_ extract 0 0) a) b c))
  (= ((_ extract 5 2) (concat a b c d)) (concat a b c))
  (= ((_ extract 3 3) (concat a b c d)) b)
  (= ((_ extract 4 3) (concat a b c d)) (concat ((_ extract 0 0) a) b))
  (= ((_ extract 5 3) (concat a b c d)) (concat a b))
  (= ((_ extract 4 4) (concat a b c d)) ((_ extract 0 0) a))
  (= ((_ extract 5 4) (concat a b c d)) a)
  (= ((_ extract 5 5) (concat a b c d)) ((_ extract 1 1) a)))))
(check-sat)
