#!/usr/bin/env python3
"""Count the source dependency closure of cvc5's internal proof checker."""
import argparse
from pathlib import Path
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from dokimasia_analyzer.tcb.__main__ import cmd_measure
from scripts.targets import checkout


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="eo_cvc5_tcb_count",
        description="Count files and lines in the transitive #include closure "
                    "of cvc5's internal proof checker. No cvc5 build is needed.",
        epilog="This measures compile-time dependencies, not runtime reachability; "
               "generated headers are omitted.")
    parser.add_argument("--cvc5", help="source checkout or its src/ directory; otherwise "
                        "DOKIMASIA_CVC5, CVC5, repos.local, deps.local.json, then deps/cvc5")
    parser.add_argument("--json", action="store_true", help="print counts as JSON")
    parser.set_defaults(seeds="proof-checker", mode="headers")
    args = parser.parse_args(argv)
    try:
        root, _ = checkout(args.cvc5)
        args.cvc5 = str(root)
        return cmd_measure(args)
    except (OSError, ValueError) as exc:
        parser.error(str(exc))


if __name__ == "__main__":
    raise SystemExit(main())
