#!/usr/bin/env python3
"""Assess recorded observations through the pinned Koine closure launcher."""
import argparse
import json
from pathlib import Path
import subprocess
import sys

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "scripts"))
import koine
import targets
from closure_baseline import baseline


def cvc5(explicit):
    """The checkout `--use-local` names, verified as cvc5 before anything reads it."""
    root, via = targets.checkout(explicit or None)
    via = "--use-local" if explicit else via
    if not root.is_dir():
        raise ValueError(f"no cvc5 checkout at {root} (from {via}); give --use-local a path, "
                         "set DOKIMASIA_CVC5, or configure scripts/repos.local")
    if not all((root / p).exists() for p in
               ("configure.sh", "src/theory", "include/cvc5/cvc5_proof_rule.h")):
        raise ValueError(f"{root} (from {via}) does not look like a cvc5 checkout")
    return root, via


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--use-local", nargs="?", const="", metavar="PATH",
                    help="read a local cvc5 checkout: PATH, or the analyzer's configured checkout")
    ap.add_argument("--since", help="baseline revision; default: newest archived cvc5 run")
    ap.add_argument("--date", help="closure date; default: today")
    ap.add_argument("--dry-run", action="store_true", help="print the scope and exit")
    ap.add_argument("--show-prompt", action="store_true")
    ap.add_argument("--codex", action="store_true")
    ap.add_argument("--print", action="store_true", dest="noninteractive")
    args = ap.parse_args()
    try:
        local = cvc5(args.use_local) if args.use_local is not None else None
        script = koine.script("koine_close_db")
        argv = [sys.executable, str(script), "--config", str(ROOT / "scripts/closure.json")]
        if args.since:
            argv += ["--since", "cvc5=" + args.since]
        if local:
            root, via = local
            argv += ["--use-local", "cvc5=" + str(root)]
            if not args.dry_run and not args.show_prompt:
                # Koine reports empty windows; Dokimasia chooses not to spend a turn on one.
                window = [sys.executable, str(koine.script("koine_window")),
                          "--baseline", baseline(args.since)[0], "--project", "cvc5",
                          "--local", str(root), "--via=" + via]
                result = subprocess.run(window + ["--json"], capture_output=True, text=True)
                if result.returncode:
                    raise ValueError(result.stderr.strip())
                if not json.loads(result.stdout)["count"]:
                    return subprocess.run(window).returncode
        if args.date:
            argv += ["--date", args.date]
        for flag in ("dry_run", "show_prompt", "codex", "noninteractive"):
            if getattr(args, flag):
                argv.append("--print" if flag == "noninteractive" else "--" + flag.replace("_", "-"))
        if not args.dry_run and not args.show_prompt and not (ROOT / "docs/experience.md").is_file():
            raise ValueError("docs/experience.md is missing; it defines the shape of what this run writes")
        return subprocess.run(argv, cwd=ROOT).returncode
    except (OSError, ValueError, KeyError) as e:
        print(f"close_bug_db: {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
